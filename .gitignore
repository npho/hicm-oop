# macOS
.DS_Store
*~
data/

# Python
.venv/
__pycache__/

# rig rvenv start
# Everything in .rvenv is machine-specific output of `rig proj sync`; it can
# be deleted and rebuilt at any time. The committed rvenv shim package lives
# in .rvenvlib instead.
/.rvenv/
# rig rvenv end

# rig rewrites the block above and expects .rvenvlib/ to be committed. This
# project does not commit it: `rig proj sync` rebuilds it on each machine.
/.rvenvlib/
